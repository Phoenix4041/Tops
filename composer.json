{
    "name": "hvns/tops",
    "description": "Leaderboards de Kills, Deaths, Dinero y Tiempo jugado con hologramas para PocketMine-MP 5.x",
    "type": "pocketmine-plugin",
    "license": "proprietary",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Muqsit/SimplePacketHandler"
        }
    ],
    "require": {
        "php": "^8.1",
        "pocketmine/pocketmine-mp": "^5.0.0",
        "cortexpe/commando": "dev-master",
        "dapigguy/libpiggyeconomy": "^3.0",
        "muqsit/simple-packet-handler": "dev-pm5"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.11"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tops\\": "src/Tops/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1"
        }
    }
}
